# Copy to a private .env.test.local, fill locally; never share or commit credentials.
# Requires Java 24 and an EXISTING reviewed database marked dev/test.
# This template does not create a database, login, role, or apply migrations.
# Use backend/run-verification.ps1 -Suite runtime with the protected SanBongApp profile.
# Committed/concurrency fixtures require a separate private .env.fixture.local and disposable DB;
# never grant audit DELETE or restore global writer roles to the web runtime just for tests.
JAVA_HOME=path_to_your_JDK_24
APP_ENV=test
SAN_BONG_TEST_MODE=test
APP_HOST=127.0.0.1
APP_PORT=8082
APP_CONTEXT_PATH=/api
APP_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=your_reviewed_test_database;encrypt=true;trustServerCertificate=false
APP_DB_USER=your_dedicated_runtime_login
APP_DB_PASSWORD=fill_privately
APP_MIGRATE_LEGACY_PASSWORDS=false
# For HTTP checks only; fill with existing DEV/test credentials privately.
AUTH_TEST_BASE_URL=http://127.0.0.1:8082/api
SQLCMD_TEST_SERVER=tcp:localhost,1433
SQLCMD_TEST_DATABASE=your_reviewed_test_database
AUTH_TEST_PASSWORD=fill_privately
