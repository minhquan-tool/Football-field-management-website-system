APP_DB_USER=your_database_user
JAVA_HOME=path_to_your_JDK_24
APP_DB_PASSWORD=your_database_password
# Optional: APP_DB_URL, APP_PORT, APP_HOST, APP_CONTEXT_PATH
# One-time conversion only when existing passwords are known to be plaintext:
APP_MIGRATE_LEGACY_PASSWORDS=false

APP_ENV=dev
APP_HOST=127.0.0.1
# For Maven/HTTP fixture tests only; database must also be classified dev/test:
# SAN_BONG_TEST_MODE=dev
# Login throttling on this single backend (defaults):
# Direct/LAN origin mode rejects framework/native forwarded-header trust and Tomcat overrides.
# Tunnel traffic may share the loopback IP budget until an isolated trusted proxy is reviewed.
APP_LOGIN_LIMIT_PER_IDENTIFIER=5
APP_LOGIN_LIMIT_PER_IP=30
APP_LOGIN_LIMIT_WINDOW_SECONDS=300
APP_LOGIN_LIMIT_MAX_ENTRIES=10000
# Receiving account only; no bank password/API key. Fill privately before enabling.
APP_BANK_TRANSFER_ENABLED=false
APP_BANK_BIN=
APP_BANK_NAME=
APP_BANK_ACCOUNT_NUMBER=
APP_BANK_ACCOUNT_NAME=
# Local PNG/JPEG exported from the bank app. Leave blank until the QR is supplied.
# Use a private file in run/; restart backend after changing the image/configuration.
APP_BANK_QR_FILE=
