# Copy outside source control to deploy.env; restrict ACL to service identity/SYSTEM/admin.
APP_ENV=internal
APP_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=QuanLySanBong;encrypt=true;trustServerCertificate=false
APP_DB_USER=your_dedicated_runtime_login
APP_DB_PASSWORD=provide_privately
APP_HOST=0.0.0.0
APP_PORT=8080
# Giao diện ở /, API ở /api; không cấu hình servlet context.
APP_SECURE_COOKIE=false
APP_MIGRATE_LEGACY_PASSWORDS=false
# JAVA_HOME must point to installed Java24 on THIS server, or java.exe is on PATH.
# APP_JAR may override packaged JAR location; paths may be relative to installation.
# With HTTPS set APP_SECURE_COOKIE=true and SERVER_SSL_ENABLED=true;
# configure trusted certificate/keystore privately and the corresponding HTTPS port.
